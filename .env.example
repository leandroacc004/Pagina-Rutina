# Copia este archivo como ".env.local" y pega ahí las claves de TU proyecto
# de Firebase (Project settings > General > Your apps > SDK setup and config).
#
# Estas claves son públicas por diseño (viajan en el código del navegador),
# la seguridad real la dan las reglas de Firestore (firestore.rules), no
# el secreto de estas variables.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
